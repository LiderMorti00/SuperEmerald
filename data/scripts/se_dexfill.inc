SE_EventScript_StarterReceived::
	goto_if_eq VAR_RESULT, MON_CANT_GIVE, SE_EventScript_StarterNoRoom
	playfanfare MUS_OBTAIN_ITEM
	message SE_Text_StarterReceived
	waitmessage
	waitfanfare
	return

SE_EventScript_StarterNoRoom::
	msgbox SE_Text_StarterNoRoom, MSGBOX_DEFAULT
	release
	end

SE_EventScript_StartersAfter::
	msgbox SE_Text_StartersAfter, MSGBOX_DEFAULT
	release
	end

SE_Text_StarterReceived:
	.string "{PLAYER} received {STR_VAR_1}!$"

SE_Text_StarterNoRoom:
	.string "Oh, there's no room left in your\n"
	.string "PC boxes. Come back later!$"

SE_Text_StartersGiven:
	.string "They grow strong with a TRAINER\n"
	.string "who travels as much as you do!$"

SE_Text_StartersAfter:
	.string "How are the three POKéMON doing?\n"
	.string "I'm sure they're in good hands.$"

SE_EventScript_LegendFled::
	fadescreenswapbuffers FADE_TO_BLACK
	removeobject VAR_LAST_TALKED
	fadescreenswapbuffers FADE_FROM_BLACK
	bufferspeciesname STR_VAR_1, VAR_0x8004
	msgbox SE_Text_LegendFled, MSGBOX_DEFAULT
	release
	end

SE_Text_LegendFled:
	.string "{STR_VAR_1} vanished…\n"
	.string "It might come back here later.$"

SE_EventScript_Leg_VICTINI::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_VICTINI, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	setvar VAR_0x8004, SPECIES_VICTINI
	setwildbattle SPECIES_VICTINI, 70
	setflag FLAG_SYS_CTRL_OBJ_DELETE
	special BattleSetup_StartLegendaryBattle
	clearflag FLAG_SYS_CTRL_OBJ_DELETE
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, SE_EventScript_LegendFled
	setflag FLAG_SE_LEG_VICTINI
	goto Common_EventScript_RemoveStaticPokemon
	end

