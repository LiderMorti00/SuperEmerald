@ Super Emerald: National Dex completion. Generated by tools/sfr/se/dexfill_events.py
SE_EventScript_Starters_UNOVA::
	lock
	faceplayer
	goto_if_set FLAG_SE_GIFT_STARTERS_UNOVA, SE_EventScript_StartersAfter
	msgbox SE_Text_Starters_UNOVA, MSGBOX_DEFAULT
	givemon SPECIES_SNIVY, 10
	bufferspeciesname STR_VAR_1, SPECIES_SNIVY
	call SE_EventScript_StarterReceived
	givemon SPECIES_TEPIG, 10
	bufferspeciesname STR_VAR_1, SPECIES_TEPIG
	call SE_EventScript_StarterReceived
	givemon SPECIES_OSHAWOTT, 10
	bufferspeciesname STR_VAR_1, SPECIES_OSHAWOTT
	call SE_EventScript_StarterReceived
	setflag FLAG_SE_GIFT_STARTERS_UNOVA
	msgbox SE_Text_StartersGiven, MSGBOX_DEFAULT
	release
	end

SE_Text_Starters_UNOVA:
	.string "I study POKéMON from the UNOVA region.\p"
	.string "These three were born at our lab,\n"
	.string "but they need a TRAINER to grow up.\p"
	.string "SNIVY, TEPIG and OSHAWOTT…\n"
	.string "Please take care of all three!$"

